# --- VM Ubuntu 22.04 (production) ---
# IP publique ou domaine de la VM
PUBLIC_HOST=
CONSOLE_PUBLIC_URL=http://localhost:3000
KEYCLOAK_ISSUER=http://localhost:8082/realms/lorawan
KEYCLOAK_PUBLIC_HOST=localhost
KEYCLOAK_PUBLIC_PORT=8082
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:8081
# URL interne pour scripts/cron sur la VM (curl localhost). La console utilise l'IP publique via rebuild-console.
# PLATFORM_API_URL=http://localhost:8081
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8082
NEXT_PUBLIC_CHIRPSTACK_URL=http://localhost:8080

# ChirpStack — créer un API token dans l'UI (http://localhost:8080)
# Admin > API keys
CHIRPSTACK_API_TOKEN=
# Tenant ChirpStack par défaut (visible dans l'UI)
CHIRPSTACK_TENANT_ID=a9307558-82d4-4dbc-9ebc-daf565804305

# Port hôte MQTT (1883 souvent déjà pris par Mosquitto local)
MQTT_HOST_PORT=1884

# MinIO (9000/9001 souvent déjà pris)
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011

# Mailpit — capture emails Keycloak en dev (UI http://localhost:8025)
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=noreply@lorawan.local

# Auth — required en production multi-tenant
AUTH_MODE=required

# MinIO object storage (payloads + firmware FUOTA)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=platform
MINIO_SECRET_KEY=platform123
MINIO_BUCKET=lorawan-payloads

# Stripe (facturation réelle — optionnel en dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/billing?paid=1
STRIPE_CANCEL_URL=http://localhost:3000/billing
CONSOLE_PUBLIC_URL=http://localhost:3000

# Keycloak Admin API (provisioning utilisateurs à la création tenant)
KEYCLOAK_ADMIN_URL=http://localhost:8082
KEYCLOAK_REALM=lorawan
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mistral:latest
# Modèles CPU recommandés : mistral:latest, llama3.2:3b, qwen2.5:3b
# OPENAI_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
